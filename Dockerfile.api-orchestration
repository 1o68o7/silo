# Image API Silo optionnelle (LEGACY) : client Docker + Compose pour SILO_WORKER_RESTART_COMMAND.
# Préférer l’orchestrateur hôte HTTP : log8ot/scripts/silo-host-orchestrator.py +
# docker-compose.silo-vps-a.host-orchestrator-client.yml (pas de socket dans l’API).
# Si vous gardez cette image : contrôle réseau fort ; socket Docker ≈ root sur l’hôte.
FROM python:3.12-slim

WORKDIR /app

RUN apt-get update -qq && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    curl \
    ca-certificates \
    docker.io \
    && rm -rf /var/lib/apt/lists/*

# Plugin Compose v2 (docker compose) — arch détectée (amd64 / arm64)
ARG DOCKER_COMPOSE_VERSION=2.29.7
RUN ARCH="$(dpkg --print-architecture)" \
    && case "$ARCH" in amd64) DC_ARCH=x86_64 ;; arm64) DC_ARCH=aarch64 ;; *) echo "unsupported arch: $ARCH" >&2; exit 1 ;; esac \
    && mkdir -p /usr/local/lib/docker/cli-plugins \
    && curl -fsSL "https://github.com/docker/compose/releases/download/v${DOCKER_COMPOSE_VERSION}/docker-compose-linux-${DC_ARCH}" \
        -o /usr/local/lib/docker/cli-plugins/docker-compose \
    && chmod +x /usr/local/lib/docker/cli-plugins/docker-compose

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .
COPY orchestration/restart-silo-worker-from-api.sh /usr/local/bin/restart-silo-worker-from-api.sh
RUN chmod +x /usr/local/bin/restart-silo-worker-from-api.sh

ENV PORT=8000
EXPOSE 8000
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2"]
