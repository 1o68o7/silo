# Brief: Scrapling + StealthyFetcher (évasion anti-bot)
# Base Scrapling avec navigateurs pré-installés
FROM pyd4vinci/scrapling:latest

WORKDIR /app

# Dépendances Silo (Scrapling déjà inclus)
RUN pip install --no-cache-dir \
    trafilatura>=2.0.0 \
    fastembed==0.4.2 \
    networkx>=3.4.2 \
    redis>=5.2.0 \
    psycopg2-binary>=2.9.10 \
    sqlalchemy>=2.0.36 \
    pgvector>=0.3.6 \
    lxml>=5.0.0 \
    numpy>=1.24.0 \
    spacy>=3.7.0 \
    cdlib>=0.3.0

# Modèle spaCy français
RUN python -m spacy download fr_core_news_lg

COPY . .
ENV PYTHONPATH=/app

# Brief §8.1 : vérifie Redis + heartbeat écrit par le worker (readiness infra).
HEALTHCHECK --interval=40s --timeout=15s --start-period=240s --retries=3 \
    CMD python -c "import os,sys,redis; from worker.redis_runtime import WORKER_RUNTIME_HEARTBEAT_KEY; r=redis.from_url(os.environ.get('REDIS_URL') or 'redis://127.0.0.1:6379/0'); r.ping(); sys.exit(0 if r.get(WORKER_RUNTIME_HEARTBEAT_KEY) else 1)"

# L'image Scrapling a ENTRYPOINT ["scrapling"] - on le réinitialise pour lancer notre worker
ENTRYPOINT []
CMD ["python", "-m", "worker.run"]
