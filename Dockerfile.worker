# Brief: Scrapling + StealthyFetcher (évasion anti-bot)
# Base Scrapling avec navigateurs pré-installés
FROM pyd4vinci/scrapling:latest

WORKDIR /app

# Dépendances Silo (Scrapling déjà inclus)
RUN pip install --no-cache-dir \
    trafilatura>=2.0.0 \
    fastembed==0.4.2 \
    networkx>=3.4.2 \
    redis>=5.2.0 \
    psycopg2-binary>=2.9.10 \
    sqlalchemy>=2.0.36 \
    pgvector>=0.3.6 \
    lxml>=5.0.0 \
    numpy>=1.24.0 \
    spacy>=3.7.0

# Modèle spaCy français
RUN python -m spacy download fr_core_news_lg

COPY . .
ENV PYTHONPATH=/app
# Réduit les surprises tokenizers / threads natifs pendant FastEmbed + spaCy
ENV TOKENIZERS_PARALLELISM=false
ENV OMP_NUM_THREADS=1
# Limite l’empilement d’arenas glibc (Python + ORT) → moins de pics RSS fantômes sous Docker
ENV MALLOC_ARENA_MAX=2
# Doit rester > plus longue section sans refresh (embed e5-large) ; aligné avec redis_runtime.HEARTBEAT_TTL_SEC
ENV SILO_WORKER_HEARTBEAT_TTL_SEC=180

# Brief §8.1 : vérifie Redis + heartbeat écrit par le worker (readiness infra).
# Intervalle large : pendant embed/NER la boucle principale peut être bloquée longtemps (heartbeats rafraîchis dans crawler).
# Clé heartbeat = silo:worker_runtime:heartbeat (NLP/full) ou silo:worker_runtime:{SILO_WORKER_CRAWL_ROLE}:heartbeat
HEALTHCHECK --interval=60s --timeout=20s --start-period=300s --retries=5 \
    CMD python -c "import os,sys,redis; r=redis.from_url(os.environ.get('REDIS_URL') or 'redis://127.0.0.1:6379/0'); role=os.environ.get('SILO_WORKER_CRAWL_ROLE','').strip(); key=f'silo:worker_runtime:{role}:heartbeat' if role else 'silo:worker_runtime:heartbeat'; r.ping(); sys.exit(0 if r.get(key) else 1)"

# L'image Scrapling a ENTRYPOINT ["scrapling"] - on le réinitialise pour lancer notre worker
ENTRYPOINT []
CMD ["python", "-m", "worker.run"]
